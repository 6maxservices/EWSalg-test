# The pod already exists. Put its OpenAI-compatible endpoints and model IDs here.
RUNPOD_TIER1_URL=https://api.runpod.ai/v2/REPLACE_TIER1/openai/v1
RUNPOD_TIER2_URL=https://api.runpod.ai/v2/REPLACE_TIER2/openai/v1
RUNPOD_TIER1_MODEL=REPLACE_WITH_EXISTING_MODEL_ID
RUNPOD_TIER2_MODEL=REPLACE_WITH_EXISTING_MODEL_ID
RUNPOD_API_KEY=REPLACE_LOCALLY

# Optional public routes. They remain default-deny and pass through DLP.
OPENAI_API_KEY=
PUBLIC_GPT_MODEL=REPLACE_WITH_REVIEWED_MODEL_ID
ANTHROPIC_API_KEY=
PUBLIC_CLAUDE_MODEL=REPLACE_WITH_REVIEWED_MODEL_ID

# Protect local clients and keep the service loopback-only.
PROXY_API_KEY=REPLACE_WITH_RANDOM_LOCAL_SECRET
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
PUBLIC_ORIGIN_ALLOWLIST=sanitizer,manual-approved
DLP_BLOCKLIST_PATH=config/blocklist.txt
DLP_ALIASES_PATH=config/aliases.json
QUERY_LOG_PATH=var/query-log.sqlite3
CORE_ROUTE_CHAR_THRESHOLD=6000

# Optional input-token rates used only for local cost estimates. Keep zero when
# a route is billed per active GPU time or the reviewed rate is unknown.
RUNPOD_TIER1_INPUT_COST_PER_MILLION=0
RUNPOD_TIER2_INPUT_COST_PER_MILLION=0
PUBLIC_GPT_INPUT_COST_PER_MILLION=0
PUBLIC_CLAUDE_INPUT_COST_PER_MILLION=0
